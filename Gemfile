# Gemfile

source 'https://rubygems.org'

# Specify your gem's dependencies
gemspec

# For testing. The rails version is governed by the gemspec dependency (>= 7.0)
# so the suite runs against whatever major version resolves.
group :development, :test do
  gem 'minitest', '>= 5.1'
  gem 'webrick', '~> 1.8'
end
